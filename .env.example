# Copy to .env and fill in. .env is gitignored.
#
# Hardhat 3 reads these through configVariable(). For anything holding real funds,
# prefer the encrypted keystore over a plaintext file:
#   npx hardhat keystore set DEPLOYER_PRIVATE_KEY

# Deployer key, without the 0x prefix is also accepted. Use a throwaway account
# for testnet and a hardware wallet or multisig for anything real.
DEPLOYER_PRIVATE_KEY=

# Or deploy from a seed phrase (12/24 words, space-separated, quoted). When this is set it
# takes precedence over DEPLOYER_PRIVATE_KEY. The deployer is the account at
# m/44'/60'/0'/0/<DEPLOYER_MNEMONIC_INDEX>; index 0 matches MetaMask's first account.
# The passphrase is the optional BIP-39 "25th word". Most wallets don't use one.
DEPLOYER_MNEMONIC=
DEPLOYER_MNEMONIC_INDEX=0
DEPLOYER_MNEMONIC_PASSPHRASE=

# Nurachain. Not in any public chain registry, so both values have to come from
# Nurachain's own docs. Leave NURACHAIN_CHAIN_ID empty to skip the chain-id check —
# at the cost of the explorer entry in hardhat.config.ts, which is keyed by chain id.
NURACHAIN_RPC_URL=https://rpc.nurachain.net
NURACHAIN_CHAIN_ID=1020

# The explorer at explorer.nurachain.net needs no API key, so there is nothing to put
# here for verification. See the verification note in README.md.
