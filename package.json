{
  "name": "bridge-tokens",
  "version": "1.0.0",
  "description": "Bridged ERC20 representations of USDT and BNB with role-gated mint and burn",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "hardhat compile && node scripts/write-init-code-hash.ts && hardhat compile",
    "initcodehash": "node scripts/write-init-code-hash.ts",
    "test": "hardhat test",
    "test:solidity": "hardhat test solidity",
    "test:fuzz": "hardhat test solidity --grep testFuzz_",
    "test:invariant": "hardhat test solidity --grep invariant_",
    "coverage": "hardhat test mocha --coverage test/BridgeToken.test.ts test/Airdrop.test.ts test/Vault.test.ts test/scripts/params.test.ts",
    "typecheck": "tsc --noEmit",
    "clean": "hardhat clean",
    "preflight:nurachain": "hardhat run scripts/preflight.ts --network nurachain",
    "deploy:nurachain": "hardhat deploy --network nurachain",
    "deploy:nurachain:token": "hardhat deploy --sc token --network nurachain",
    "deploy:nurachain:airdrop": "hardhat deploy --sc airdrop --network nurachain",
    "deploy:nurachain:univ2": "hardhat deploy --sc univ2 --network nurachain",
    "deploy:nurachain:univ3": "hardhat deploy --sc univ3 --network nurachain",
    "deploy:nurachain:vault": "hardhat deploy --sc vault --network nurachain",
    "setup:nurachain:vault": "hardhat run scripts/vault-setup.ts --network nurachain"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox-mocha-ethers": "^3.0.7",
    "@types/chai": "^5.2.2",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.0.0",
    "chai": "^5.2.0",
    "dotenv": "^17.4.2",
    "ethers": "^6.15.0",
    "hardhat": "^3.13.0",
    "mocha": "^11.0.0",
    "typescript": "~5.9.0"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.6.1"
  }
}
