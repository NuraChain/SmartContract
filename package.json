{
  "name": "bridge-tokens",
  "version": "1.0.0",
  "description": "Bridged ERC20 representations of USDT and BNB with role-gated mint and burn",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "hardhat compile",
    "test": "hardhat test",
    "typecheck": "tsc --noEmit",
    "clean": "hardhat clean",
    "preflight:nurachain": "hardhat run scripts/preflight.ts --network nurachain",
    "deploy:testnet": "hardhat ignition deploy ignition/modules/BridgeTokens.ts --network bscTestnet",
    "deploy:bsc": "hardhat ignition deploy ignition/modules/BridgeTokens.ts --network bsc",
    "deploy:nurachain": "hardhat ignition deploy ignition/modules/BridgeTokens.ts --network nurachain"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox-mocha-ethers": "^3.0.7",
    "@types/chai": "^5.2.2",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.0.0",
    "chai": "^5.2.0",
    "dotenv": "^17.4.2",
    "ethers": "^6.15.0",
    "hardhat": "^3.13.0",
    "mocha": "^11.0.0",
    "typescript": "~5.9.0"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.6.1"
  }
}
