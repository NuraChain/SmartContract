{
  "compilerOptions": {
    "target": "ES2023",
    "module": "node18",
    "moduleResolution": "node16",
    "lib": ["ES2023"],
    "types": ["node", "mocha"],
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true
  },
  // "types" holds the TypeChain bindings that `hardhat compile` generates. Including
  // them is what makes `ethers.deployContract("BridgeUSDT", ...)` return a typed
  // contract instead of a bare BaseContract.
  "include": [
    "hardhat.config.ts",
    "test/**/*.ts",
    "ignition/**/*.ts",
    "scripts/**/*.ts",
    "types/**/*.ts"
  ]
}
