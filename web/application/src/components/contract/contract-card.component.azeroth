import { CATEGORY_LABEL } from '../../config/contracts.ts';
import type { ContractDef } from '../../config/contracts.ts';
import { explorerAddressUrl } from '../../config/chain.ts';
import { parseAbiFunctions } from '../../lib/abi.ts';
import { shortAddress } from '../../lib/format.ts';

import Icon from '../ui/icon.component.azeroth';

// One contract on the list: identity, address, network, function counts, and
// the two honest exits - manage here, or read it on the explorer.

export default component ContractCard(props: { def: ContractDef })
{
    derived counts = parseAbiFunctions(props.def.abi);

    <article class="card flex flex-col p-4" data-testid={ `contract-${ props.def.id }` }>
        <div class="mb-2 flex items-start justify-between gap-3">
            <h3 class="font-display text-sm font-medium text-ink">{ props.def.name }</h3>
            <span class="shrink-0 rounded-full bg-ice/15 px-2 py-0.5 text-[10px] font-semibold tracking-wide text-ice">
                { CATEGORY_LABEL[props.def.category] }
            </span>
        </div>
        <Show
            when={ props.def.address }
            fallback={
                <p class="flex items-center gap-1.5 text-xs text-fall" data-testid="no-address">
                    <Icon name="triangle-alert" size={ 13 } class="shrink-0" />
                    No deployment recorded
                </p>
            }
            let={ address }
        >
            <p class="truncate font-mono text-xs text-faint" data-ltr title={ address }>
                { shortAddress(address) }
            </p>
        </Show>
        <p class="mt-2 line-clamp-2 min-h-8 text-xs leading-relaxed text-faint">{ props.def.description }</p>
        <div class="mt-3 flex items-center gap-3 border-t border-line pt-3 text-[11px] text-faint">
            <span>Chain <span class="font-mono" data-ltr>{ String(props.def.chainId) }</span></span>
            <span aria-hidden="true">·</span>
            <span><span class="font-mono">{ String(counts.reads.length) }</span> read</span>
            <span aria-hidden="true">·</span>
            <span><span class="font-mono">{ String(counts.writes.length) }</span> write</span>
        </div>
        <div class="mt-4 flex gap-2">
            <a
                href={ `/contracts/${ props.def.id }` }
                class="btn-ice h-9 flex-1 px-3 text-center text-[13px]"
            >
                Manage Contract
            </a>
            <Show when={ props.def.address }>
                <a
                    href={ explorerAddressUrl(props.def.address as string) }
                    target="_blank"
                    rel="noreferrer"
                    class="btn-ghost h-9 shrink-0 px-3 text-[13px]"
                    aria-label={ `Open ${ props.def.name } on the explorer` }
                >
                    <Icon name="arrow-up-right" size={ 14 } />
                    Explorer
                </a>
            </Show>
        </div>
    </article>
}
