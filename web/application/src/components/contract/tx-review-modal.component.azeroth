import { NURA_CHAIN, explorerAddressUrl, explorerTxUrl } from '../../config/chain.ts';
import type { ContractDef } from '../../config/contracts.ts';
import { shortAddress, fmtGas, groupDigits } from '../../lib/format.ts';
import { formatValue } from '../../lib/abi.ts';
import type { FunctionSpec } from '../../lib/abi.ts';
import { classifyError } from '../../lib/errors.ts';
import type { ClassifiedError } from '../../lib/errors.ts';
import { prepareWrite, submitWrite } from '../../lib/tx-manager.ts';
import type { WriteRequest } from '../../lib/tx-manager.ts';
import {
    account,
    connectedVia,
    onRightChain,
    switchChain,
    walletChainId
} from '../../lib/wallet/store.ts';

import Button from '../ui/button.component.azeroth';
import Icon from '../ui/icon.component.azeroth';
import Modal from '../ui/modal.component.azeroth';
import CopyButton from './copy-button.component.azeroth';

// THE transparency gate. Before any wallet prompt this shows the contract,
// address, exact function signature, every parameter AS IT WILL BE ENCODED,
// the attached native value, the wallet, the network, and a gas estimate.
// Confirm is never vague: the button names the function being sent.
//
// Stages: preparing -> review -> signing -> pending -> confirmed | failed.

type Stage = 'preparing' | 'review' | 'signing' | 'pending' | 'confirmed' | 'failed';

export default component TxReviewModal(props: {
    def: ContractDef;
    fn: FunctionSpec;
    collectRequest: () => WriteRequest | null;
    onClose: () => void;
})
{
    state stage: Stage = 'preparing';
    state request: WriteRequest | null = null;
    state gasEstimate: bigint | null = null;
    state calldata: string | null = null;
    state failure: ClassifiedError | null = null;
    state hash: string | null = null;
    state switching = false;

    const begin = (): void =>
    {
        // Re-validate on open: the form may have drifted between render and click.
        const built = props.collectRequest();
        if (built === null)
        {
            failure = classifyError(new Error('InvalidInputError: parameters changed - close and re-check the fields'));
            stage = 'failed';
            return;
        }
        request = built;
        void prepare();
    };

    const prepare = async (): Promise<void> =>
    {
        if (request === null)
        {
            return;
        }
        stage = 'preparing';
        try
        {
            const prepared = await prepareWrite(request);
            gasEstimate = prepared.gasEstimate;
            calldata = prepared.calldata;
            stage = 'review';
        }
        catch (error)
        {
            failure = classifyError(error);
            stage = 'failed';
        }
    };

    const confirm = async (): Promise<void> =>
    {
        if (request === null || inFlight())
        {
            return;
        }
        try
        {
            const outcome = await submitWrite(request, {
                onPhase: (phase) =>
                {
                    stage = phase === 'signing' ? 'signing' : 'pending';
                },
                onHash: (value) =>
                {
                    hash = value;
                }
            });
            hash = outcome.hash ?? hash;
            stage = outcome.status === 'confirmed' ? 'confirmed' : 'failed';
            if (outcome.status !== 'confirmed')
            {
                failure = classifyError(new Error(`execution reverted: ${ request.signature } reverted on-chain`));
            }
        }
        catch (error)
        {
            failure = classifyError(error);
            stage = 'failed';
        }
    };

    const inFlight = (): boolean => stage === 'signing' || stage === 'pending';

    const doSwitch = (): void =>
    {
        switching = true;
        void switchChain().finally(() =>
        {
            switching = false;
            void prepare();
        });
    };

    const paramRows = (): Array<{ label: string; type: string; value: string }> =>
    {
        const current = request;
        if (current === null)
        {
            return [];
        }
        return props.fn.inputs.map((inputSpec, position) => ({
            label: inputSpec.name !== '' ? inputSpec.name : `param${ position + 1 }`,
            type: inputSpec.type,
            value: argDisplay(current.args[position])
        }));
    };

    const walletLabel = (): string | null =>
        account() === null ? null : shortAddress(account() as string);

    mount
    {
        begin();
    }

    <Modal title="Transaction Review" onClose={ () => { if (!inFlight()) { props.onClose(); } } }>
        <Show when={ request !== null } fallback={
            <p class="py-6 text-center text-sm text-faint">Preparing…</p>
        }>
            <div class="flex flex-col gap-4" data-testid="tx-review">
                <div class="rounded-lg border border-line bg-panel px-3 py-2">
                    <div class="flex items-baseline justify-between gap-3 py-1 text-sm">
                        <span class="shrink-0 text-xs text-faint">Contract</span>
                        <span class="min-w-0 truncate text-end text-ink">{ props.def.name }</span>
                    </div>
                    <div class="flex items-baseline justify-between gap-3 py-1 text-sm">
                        <span class="shrink-0 text-xs text-faint">Address</span>
                        <span class="flex min-w-0 items-center gap-1">
                            <a
                                href={ explorerAddressUrl((request as WriteRequest).address) }
                                target="_blank"
                                rel="noreferrer"
                                class="truncate font-mono text-ice hover:underline"
                                data-ltr
                            >
                                { shortAddress((request as WriteRequest).address) }
                            </a>
                            <CopyButton value={ (request as WriteRequest).address } label="Copy contract address" />
                        </span>
                    </div>
                    <div class="flex items-baseline justify-between gap-3 py-1 text-sm">
                        <span class="shrink-0 text-xs text-faint">Function</span>
                        <span class="min-w-0 truncate text-end font-mono text-ink" data-ltr>{ props.fn.signature }</span>
                    </div>
                    <div class="flex items-baseline justify-between gap-3 py-1 text-sm">
                        <span class="shrink-0 text-xs text-faint">Network</span>
                        <span class="flex items-center gap-1.5">
                            <Show when={ account() !== null && !onRightChain() }>
                                <Icon name="triangle-alert" size={ 13 } class="text-fall" />
                            </Show>
                            { NURA_CHAIN.name } · <span data-ltr>{ String(NURA_CHAIN.id) }</span>
                            <Show when={ walletChainId() !== null && !onRightChain() }>
                                <span class="text-fall">(wallet on <span data-ltr>{ String(walletChainId()) }</span>)</span>
                            </Show>
                        </span>
                    </div>
                    <div class="flex items-baseline justify-between gap-3 py-1 text-sm">
                        <span class="shrink-0 text-xs text-faint">Wallet</span>
                        <Show
                            when={ walletLabel() !== null }
                            fallback={ <span class="text-fall">Not connected</span> }
                        >
                            <span class="font-mono" data-ltr>{ walletLabel() }</span>
                            <Show when={ connectedVia() }>
                                <span class="text-xs text-faint">via { connectedVia() }</span>
                            </Show>
                        </Show>
                    </div>
                    <div class="flex items-baseline justify-between gap-3 py-1 text-sm">
                        <span class="shrink-0 text-xs text-faint">Estimated gas</span>
                        <Show when={ gasEstimate !== null } fallback={ <span class="text-faint">Unavailable</span> }>
                            <span class="font-mono text-val" data-ltr>{ fmtGas(gasEstimate) }</span>
                        </Show>
                    </div>
                </div>

                <div class="flex flex-col gap-1.5">
                    <p class="eyebrow">Parameters</p>
                    <For each={ paramRows() } key={ (row) => row.label } let={ row }>
                        <div class="rounded-lg border border-line bg-raised px-3 py-2">
                            <div class="flex items-baseline justify-between gap-3">
                                <span class="font-mono text-[13px] text-ink" data-ltr>{ row.label }</span>
                                <span class="font-mono text-[10px] text-faint" data-ltr>{ row.type }</span>
                            </div>
                            <p class="mt-0.5 break-all font-mono text-[12px] text-val" data-ltr>{ row.value }</p>
                        </div>
                    </For>
                    <Show when={ props.fn.inputs.length === 0 && !props.fn.payable }>
                        <p class="text-xs text-faint">No parameters.</p>
                    </Show>
                    <Show when={ props.fn.payable }>
                        <div class={ `rounded-lg border px-3 py-2 ${ (request as WriteRequest).value > 0n ? 'border-val/40 bg-val/10' : 'border-line bg-raised' }` }>
                            <div class="flex items-baseline justify-between gap-3">
                                <span class="font-mono text-[13px] text-ink" data-ltr>value</span>
                                <span class="font-mono text-[10px] text-faint" data-ltr>uint256</span>
                            </div>
                            <p class="mt-0.5 break-all font-mono text-[12px] text-val" data-ltr>
                                { `${ groupDigits((request as WriteRequest).value.toString()) } wei (${ fmtNativeValue((request as WriteRequest).value) } NURA)` }
                            </p>
                        </div>
                    </Show>
                </div>

                <details class="mt-1">
                    <summary class="cursor-pointer text-[11px] text-faint hover:text-ink">Raw calldata</summary>
                    <pre class="mt-1 max-h-32 overflow-auto whitespace-pre-wrap break-all font-mono text-[11px] text-faint" data-ltr>{ calldata ?? '' }</pre>
                </details>

                <Show when={ stage === 'preparing' }>
                    <div class="flex items-start gap-2 rounded-lg border border-line bg-panel px-3 py-2 text-sm text-ink" role="status" data-testid="review-preparing">
                        <Icon name="refresh-cw" size={ 15 } class="shrink-0 animate-spin text-ice" />
                        <span>Estimating gas and validating…</span>
                    </div>
                </Show>

                <Show when={ stage === 'signing' }>
                    <div class="flex items-start gap-2 rounded-lg border border-line bg-panel px-3 py-2 text-sm text-ink" role="status" data-testid="review-signing">
                        <Icon name="wallet" size={ 15 } class="shrink-0 text-ice" />
                        <span>Waiting for your wallet - approve or reject there. Nothing is sent until you do.</span>
                    </div>
                </Show>

                <Show when={ stage === 'pending' }>
                    <div class="flex items-start gap-2 rounded-lg border border-line bg-panel px-3 py-2 text-sm text-ink" role="status" data-testid="review-pending">
                        <Icon name="refresh-cw" size={ 15 } class="shrink-0 animate-spin text-ice" />
                        <span class="min-w-0 break-all">
                            Transaction submitted - waiting for confirmation…
                            <Show when={ hash !== null } fallback={ null }>
                                <a href={ explorerTxUrl(hash as string) } target="_blank" rel="noreferrer" class="ms-2 font-mono text-xs text-ice underline" data-ltr>
                                    { shortAddress(hash as string) }
                                </a>
                            </Show>
                        </span>
                    </div>
                </Show>

                <Show when={ stage === 'confirmed' }>
                    <div class="rounded-lg border border-rise/40 bg-rise/10 p-3" role="status" data-testid="tx-confirmed">
                        <p class="flex items-center gap-2 text-sm font-medium text-rise">
                            <Icon name="check" size={ 15 } />
                            Transaction confirmed
                        </p>
                        <Show when={ hash !== null }>
                            <a href={ explorerTxUrl(hash as string) } target="_blank" rel="noreferrer" class="mt-1 block truncate font-mono text-xs text-ice underline" data-ltr>
                                { hash }
                            </a>
                        </Show>
                    </div>
                </Show>

                <Show when={ stage === 'failed' && failure !== null }>
                    <div class="rounded-lg border border-fall/40 bg-fall/10 p-3" role="alert" data-testid="tx-failed">
                        <p class="text-sm font-medium text-fall">{ failure.title }</p>
                        <p class="mt-0.5 text-xs text-faint">{ failure.hint }</p>
                        <details class="mt-2">
                            <summary class="cursor-pointer text-[11px] text-faint hover:text-ink">Technical details</summary>
                            <pre class="mt-1 max-h-40 overflow-auto whitespace-pre-wrap break-all font-mono text-[11px] text-faint" data-ltr>{ failure.technical }</pre>
                        </details>
                    </div>
                </Show>

                <div class="flex flex-col-reverse gap-2 sm:flex-row sm:justify-end">
                    <Show
                        when={ inFlight() || stage === 'confirmed' }
                        fallback={
                            <Button variant="ghost" disabled={ false } onClick={ () => props.onClose() } testId="review-cancel">
                                Cancel
                            </Button>
                        }
                    >
                        <Button variant="ghost" onClick={ () => props.onClose() } testId="review-close">
                            Close
                        </Button>
                    </Show>
                    <Show when={ stage === 'review' && account() !== null && !onRightChain() }>
                        <Button onClick={ doSwitch } busy={ switching } testId="review-switch-network">
                            Switch Network
                        </Button>
                    </Show>
                    <Show when={ stage === 'review' }>
                        <Button
                            onClick={ () => void confirm() }
                            disabled={ account() === null || !onRightChain() }
                            testId="review-confirm"
                        >
                            <Icon name="zap" size={ 14 } />
                            Confirm `{ props.fn.name }`
                        </Button>
                    </Show>
                </div>
            </div>
        </Show>
    </Modal>
}

function argDisplay(arg: unknown): string
{
    return formatValue(arg);
}

function fmtNativeValue(wei: bigint): string
{
    if (wei === 0n)
    {
        return '0';
    }
    const whole = wei / 10n ** 18n;
    const fraction = (wei % 10n ** 18n).toString().padStart(18, '0').replace(/0+$/, '');
    return `${ whole }${ fraction === '' ? '' : `.${ fraction.slice(0, 6) }` }`;
}
