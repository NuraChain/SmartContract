import { dismissToast, toasts } from '../../lib/toast.ts';

import Icon from './icon.component.azeroth';
import Shamseh from './shamseh.component.azeroth';

export default component Toasts()
{
    <div class="pointer-events-none fixed inset-x-0 bottom-4 z-50 flex flex-col items-center gap-2 px-4">
        <For each={ toasts() } key={ (toast) => toast.id } let={ toast }>
            <div
                class="pointer-events-auto flex w-full max-w-sm items-center gap-3 rounded-xl border border-line bg-raised px-4 py-3 text-sm shadow-lg motion-safe:animate-rise"
                class:border-rise={ toast.kind === 'success' }
                class:border-fall={ toast.kind === 'error' }
                role="status"
            >
                <Show when={ toast.kind === 'pending' }>
                    <Shamseh size={ 18 } class="shrink-0 animate-spin text-ice" />
                </Show>
                <Show when={ toast.kind === 'success' }>
                    <Icon name="check" size={ 18 } class="shrink-0 text-rise" />
                </Show>
                <Show when={ toast.kind === 'error' }>
                    <Icon name="triangle-alert" size={ 18 } class="shrink-0 text-fall" />
                </Show>
                <span class="flex-1">
                    { toast.text }
                    <Show when={ toast.link } let={ link }>
                        <a href={ link.href } target="_blank" rel="noreferrer" class="ms-2 text-ice underline">
                            { link.label }
                        </a>
                    </Show>
                </span>
                <button
                    type="button"
                    class="shrink-0 text-faint hover:text-ink"
                    aria-label="Dismiss"
                    onClick={ () => dismissToast(toast.id) }
                >
                    <Icon name="x" size={ 14 } />
                </button>
            </div>
        </For>
    </div>
}
