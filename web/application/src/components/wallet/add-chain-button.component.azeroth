import { addChainToWallet } from '../../lib/wallet/store.ts';

import Icon from '../ui/icon.component.azeroth';

// "Add Nura Chain to the wallet" - registration without switching. Two shapes:
// a compact icon-only square for dense bars, and a labelled full-width button
// for menus and empty states.

export default component AddChainButton(props: { compact?: boolean; onDone?: () => void })
{
    const add = (): void =>
    {
        void addChainToWallet().then(() => props.onDone?.());
    };

    <Show
        when={ props.compact ?? false }
        fallback={
            <button
                type="button"
                class="flex min-h-11 w-full items-center justify-center gap-2 rounded-lg border border-line px-3 text-sm text-faint hover:border-ice hover:text-ink"
                onClick={ add }
            >
                <Icon name="plus" size={ 15 } />
                Add Nura Chain to wallet
            </button>
        }
    >
        <button
            type="button"
            class="hidden rounded-lg p-2 text-faint hover:text-ink sm:block"
            aria-label="Add Nura Chain to wallet"
            onClick={ add }
        >
            <Icon name="plus" size={ 18 } />
        </button>
    </Show>
}
