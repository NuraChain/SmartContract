import { Link, useParams } from 'azerothjs';
import type { Child } from 'azerothjs';

import { NURA_CHAIN, explorerAddressUrl } from '../config/chain.ts';
import { CATEGORY_LABEL, findContract } from '../config/contracts.ts';
import type { ContractDef } from '../config/contracts.ts';
import { parseAbiFunctions } from '../lib/abi.ts';
import type { FunctionSpec } from '../lib/abi.ts';
import { codeAt } from '../lib/chain-client.ts';
import { shortAddress } from '../lib/format.ts';
import { startDiscovery } from '../lib/wallet/store.ts';

import CopyButton from '../components/contract/copy-button.component.azeroth';
import ReadCard from '../components/contract/read-card.component.azeroth';
import WrongNetworkBanner from '../components/contract/wrong-network-banner.component.azeroth';
import WriteCard from '../components/contract/write-card.component.azeroth';
import EmptyState from '../components/ui/empty-state.component.azeroth';
import Icon from '../components/ui/icon.component.azeroth';
import Input from '../components/ui/input.component.azeroth';

// The contract workbench: overview, then every callable function the ABI
// declares - reads as static calls, writes behind the review flow.

export default component ContractDetail()
{
    const params = useParams();
    state query = '';
    state deployed: boolean | null = null;

    // Plain readers over the router params - called inside the tracked template.
    const found = (): ContractDef | undefined => findContract(params().id);
    const d = (): ContractDef => found() as ContractDef;
    const parsed = (): ReturnType<typeof parseAbiFunctions> | null =>
        found() !== undefined ? parseAbiFunctions(d().abi) : null;

    const reads = (): FunctionSpec[] =>
    {
        const value = parsed();
        if (value === null)
        {
            return [];
        }
        const names = new Set(found()?.staticCallables ?? []);
        return value.writes.filter((fn) => names.has(fn.name)).concat(value.reads);
    };

    const writes = (): FunctionSpec[] =>
    {
        const value = parsed();
        if (value === null)
        {
            return [];
        }
        const names = new Set(found()?.staticCallables ?? []);
        return value.writes.filter((fn) => !names.has(fn.name));
    };

    const matchReads = (): FunctionSpec[] =>
    {
        const text = query.trim().toLowerCase();
        return text === '' ? reads() : reads().filter((fn) => fn.signature.toLowerCase().includes(text));
    };

    const matchWrites = (): FunctionSpec[] =>
    {
        const text = query.trim().toLowerCase();
        return text === '' ? writes() : writes().filter((fn) => fn.signature.toLowerCase().includes(text));
    };

    const checkCode = async (id?: string): Promise<void> =>
    {
        const target = id === undefined ? found() : findContract(id);
        if (target === undefined || target.address === null)
        {
            deployed = null;
            return;
        }
        deployed = await codeAt(target.address);
    };

    mount
    {
        startDiscovery();
        void checkCode();
    }

    effect (params().id)
    {
        deployed = null;
        void checkCode(params().id);
    }

    <Show
        when={ found() !== undefined }
        fallback={
            <section class="mx-auto w-full max-w-6xl px-4 py-16">
                <EmptyState title="Unknown contract" hint="This id is not in the registry.">
                    <Link to="/contracts" class="btn-ghost mt-2 px-4 py-2 text-sm">Back to contracts</Link>
                </EmptyState>
            </section>
        }
    >
        <section class="mx-auto w-full max-w-6xl px-4 py-8 sm:py-12">
            <Link to="/contracts" class="mb-4 inline-flex items-center gap-1 text-xs text-faint hover:text-ink">
                <Icon name="chevron-left" size={ 13 } class="rtl:rotate-180" />
                All contracts
            </Link>

            <div class="mb-5 flex flex-wrap items-start justify-between gap-3">
                <div class="min-w-0">
                    <h1 class="font-display text-xl font-bold tracking-wide text-ink sm:text-2xl">{ d().name }</h1>
                    <p class="mt-1 max-w-3xl text-sm leading-relaxed text-faint">{ d().description }</p>
                </div>
                <span class="shrink-0 rounded-full bg-ice/15 px-2.5 py-1 text-[11px] font-semibold tracking-wide text-ice">
                    { CATEGORY_LABEL[d().category] }
                </span>
            </div>

            <WrongNetworkBanner />

            <div class="mt-5 grid gap-6 lg:grid-cols-[340px_1fr]">
                <aside class="min-w-0">
                    <h2 class="eyebrow mb-3">Overview</h2>
                    <div class="card flex flex-col p-4" data-testid="overview">
                        <OverviewRow label="Address">
                            <Show
                                when={ d().address }
                                fallback={ <span class="text-xs text-fall">No deployment recorded</span> }
                                let={ address }
                            >
                                <span class="flex min-w-0 items-center gap-1">
                                    <a
                                        href={ explorerAddressUrl(address) }
                                        target="_blank"
                                        rel="noreferrer"
                                        class="truncate font-mono text-xs text-ice hover:underline"
                                        data-ltr
                                        title={ address }
                                    >
                                        { shortAddress(address) }
                                    </a>
                                    <CopyButton value={ address } label="Copy contract address" testId="copy-address" />
                                </span>
                            </Show>
                        </OverviewRow>
                        <OverviewRow label="Network">
                            <span>{ NURA_CHAIN.name }</span>
                        </OverviewRow>
                        <OverviewRow label="Chain ID">
                            <span class="font-mono" data-ltr>{ String(NURA_CHAIN.id) }</span>
                        </OverviewRow>
                        <OverviewRow label="Explorer">
                            <Show when={ d().address } let={ address }>
                                <a href={ explorerAddressUrl(address) } target="_blank" rel="noreferrer" class="inline-flex items-center gap-1 text-xs text-ice hover:underline">
                                    View on explorer <Icon name="arrow-up-right" size={ 12 } />
                                </a>
                            </Show>
                        </OverviewRow>
                        <OverviewRow label="ABI">
                            <span class="flex items-center gap-1 text-rise">
                                <Icon name="check" size={ 12 } /> Bundled ({ String(d().abi.length) } entries)
                            </span>
                        </OverviewRow>
                        <OverviewRow label="On-chain code">
                            <Show
                                when={ d().address !== null && deployed !== null }
                                fallback={
                                    <span class="text-xs text-faint">
                                        { d().address === null ? 'No address to check' : 'Checking…' }
                                    </span>
                                }
                            >
                                <Show when={ deployed === true } fallback={ <span class="text-fall">Not found on-chain</span> }>
                                    <span class="flex items-center gap-1 text-rise"><Icon name="check" size={ 12 } /> Verified present</span>
                                </Show>
                            </Show>
                        </OverviewRow>
                        <Show when={ d().deploymentNote }>
                            <p class="mt-3 border-t border-line pt-3 text-[11px] leading-relaxed text-faint">
                                Deployment: { d().deploymentNote }
                            </p>
                        </Show>
                    </div>
                </aside>

                <div class="min-w-0">
                    <div class="mb-4 lg:w-96">
                        <Input value={ query } onInput={ (value) => { query = value; } } placeholder="Filter functions by signature" icon="search" mono testId="function-search" />
                    </div>

                    <section aria-labelledby="read-functions-heading" class="mb-8" data-testid="read-section">
                        <div class="mb-2 flex items-baseline gap-2">
                            <h2 id="read-functions-heading" class="font-display text-sm font-medium tracking-wide text-ink">Read Functions</h2>
                            <span class="rounded-full bg-ice/15 px-2 py-0.5 text-[10px] font-semibold text-ice" data-ltr>{ String(reads().length) }</span>
                            <span class="text-[11px] text-faint">static calls - no wallet needed</span>
                        </div>
                        <Show
                            when={ matchReads().length > 0 }
                            fallback={ <p class="rounded-xl border border-line bg-panel px-4 py-6 text-center text-xs text-faint">No read functions match.</p> }
                        >
                            <div class="flex flex-col gap-2">
                                <For each={ matchReads() } key={ (fn) => fn.signature } let={ fn }>
                                    <div>
                                        <ReadCard def={ d() } fn={ fn } testId={ `read-card-${ fn.name }` } />
                                    </div>
                                </For>
                            </div>
                        </Show>
                    </section>

                    <section aria-labelledby="write-functions-heading" data-testid="write-section">
                        <div class="mb-2 flex items-baseline gap-2">
                            <h2 id="write-functions-heading" class="font-display text-sm font-medium tracking-wide text-ink">Write Functions</h2>
                            <span class="rounded-full bg-fall/15 px-2 py-0.5 text-[10px] font-semibold text-fall" data-ltr>{ String(writes().length) }</span>
                            <span class="text-[11px] text-faint">state-changing - signed through your wallet</span>
                        </div>
                        <Show
                            when={ matchWrites().length > 0 }
                            fallback={ <p class="rounded-xl border border-line bg-panel px-4 py-6 text-center text-xs text-faint">No write functions match.</p> }
                        >
                            <div class="flex flex-col gap-2">
                                <For each={ matchWrites() } key={ (fn) => fn.signature } let={ fn }>
                                    <div>
                                        <WriteCard def={ d() } fn={ fn } testId={ `write-card-${ fn.name }` } />
                                    </div>
                                </For>
                            </div>
                        </Show>
                    </section>
                </div>
            </div>
        </section>
    </Show>
}

component OverviewRow(props: { label: string; children?: Child })
{
    <div class="flex items-baseline justify-between gap-3 border-b border-line py-2 last:border-b-0">
        <span class="shrink-0 text-xs text-faint">{ props.label }</span>
        <span class="min-w-0 truncate text-end">{ props.children }</span>
    </div>
}
